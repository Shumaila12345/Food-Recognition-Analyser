data-router-head="" data-intended-title="Claude"></head><body class="bg-surface-1 text-primary font-ui min-h-screen chat-ui-core"><script type="application/json" id="static-composer-translations">{"de-DE":{"greeting":"Du bist da!","placeholder":"Wie kann ich dir heute helfen?","aria-label":"Schreiben Sie Ihre Anfrage an Claude"},"fr-FR":{"greeting":"Vous voilà !","placeholder":"Comment puis-je vous aider ?","aria-label":"Écrivez votre invite à Claude."},"ko-KR":{"greeting":"안녕하세요!","placeholder":"오늘 어떤 도움을 드릴까요?","aria-label":"Claude에게 프롬프트를 입력하세요."},"ja-JP":{"greeting":"ようこそ！","placeholder":"本日はどのようなお手伝いをさせていただけますか？","aria-label":"クロードにプロンプトを入力してください"},"es-419":{"greeting":"¡Aquí estás!","placeholder":"¿Cómo puedo ayudarle hoy?","aria-label":"Escriba su mensaje para Claude"},"es-ES":{"greeting":"¡Ya estás aquí!","placeholder":"¿Cómo puedo ayudarle hoy?","aria-label":"Escriba su consulta para Claude"},"it-IT":{"greeting":"Eccoti!","placeholder":"Come posso aiutarti oggi?","aria-label":"Scrivi il tuo prompt per Claude"},"hi-IN":{"greeting":"नमस्ते!","placeholder":"आज मैं आपकी कैसे मदद कर सकता/सकती हूं?","aria-label":"Claude को अपना प्रॉम्प्ट लिखें"},"pt-BR":{"greeting":"Que bom ter você aqui!","placeholder":"Como posso ajudar você hoje?","aria-label":"Escreva as instruções para o Claude"},"id-ID":{"greeting":"Halo, kamu!","placeholder":"Apa yang bisa saya bantu hari ini?","aria-label":"Tulis prompt Anda ke Claude"}}</script><script type="application/ld+json">{
